# Terraform working data and local inputs
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/*.tfvars
terraform/*.auto.tfvars
terraform/crash.log

# Generated inventory and test evidence
ansible/inventory/*
!ansible/inventory/.gitkeep
evidence/*
!evidence/.gitkeep

# Local secret/config material must never be added
.env
.env.*
.envrc
.vault-init.json
*.secret
*.secrets.*
*.vault.yml
*.env.macrun

# Build artifacts and copied binaries
artifacts/
*.tar
*.tar.gz
*.capsule

# Editor/OS noise
.DS_Store
