[Unit]
Description=Gump memory-only workload node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gump
Group=gump
UMask=0077
RuntimeDirectory=gump
RuntimeDirectoryMode=0700
Environment=GUMP_RUNTIME_DIR={{ gump_runtime_dir }}
ExecStart=/bin/sh -c 'exec 3<&0; exec {{ gump_server_command }}'
StandardInput=socket
LimitCORE=0
LimitMEMLOCK=infinity
LimitNOFILE=65536
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Parameters arrive once through the activated Unix socket and inherited FD.
# No secret is embedded in this unit or written to a parameter file.
