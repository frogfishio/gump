[Unit]
Description=Caddy on-demand TLS allowlist backed by Consul prepared queries
After=network-online.target consul.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/caddy-consul-ask.py --listen-host {{ caddy_ask_listen_host }} --listen-port {{ caddy_ask_listen_port }} --consul-http {{ caddy_consul_http_addr }}
Restart=on-failure
RestartSec=2
User=root
Group=root

[Install]
WantedBy=multi-user.target