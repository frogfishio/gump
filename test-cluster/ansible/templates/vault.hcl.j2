ui = true
disable_mlock = true

api_addr = "http://{{ hostvars[inventory_hostname]['cluster_private_ip'] }}:8200"
cluster_addr = "http://{{ hostvars[inventory_hostname]['cluster_private_ip'] }}:8201"

storage "raft" {
  path    = "/opt/vault/data"
  node_id = "{{ inventory_hostname }}"
{% for host in groups['frogfish'] if host != inventory_hostname %}
  retry_join {
    leader_api_addr = "http://{{ hostvars[host]['cluster_private_ip'] }}:8200"
  }
{% endfor %}
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "{{ hostvars[inventory_hostname]['cluster_private_ip'] }}:8201"
  tls_disable     = 1
}

service_registration "consul" {
  address = "http://127.0.0.1:8500"
}