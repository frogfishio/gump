{
{% if caddy_contact_email | default('') | length > 0 %}
  email {{ caddy_contact_email }}
{% endif %}
{% if caddy_acme_ca | default('') | length > 0 %}
  acme_ca {{ caddy_acme_ca }}
{% endif %}

  on_demand_tls {
    ask http://{{ caddy_ask_listen_host }}:{{ caddy_ask_listen_port }}/allow
  }
}

http:// {
  redir https://{host}{uri} 308
}

https:// {
  tls {
    on_demand
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  encode zstd gzip

  reverse_proxy {
    dynamic srv _{host}._tcp.query.consul {
      resolvers {{ caddy_consul_dns_addr }}
      refresh 10s
    }

    lb_policy random
    fail_duration 30s

    transport http {
      dial_timeout 3s
      response_header_timeout 10s
      keepalive 30s
      resolvers {{ caddy_consul_dns_addr }}
    }
  }

  log {
    output stdout
    format console
  }
}