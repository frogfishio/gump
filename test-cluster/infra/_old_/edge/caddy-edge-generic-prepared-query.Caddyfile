{
    email info@ramblerbooks.com
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    on_demand_tls {
        ask http://127.0.0.1:9123/allow
    }
}

http:// {
    redir https://{host}{uri} 308
}

https:// {
    tls {
        on_demand
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    encode zstd gzip

    reverse_proxy {
        # Generic path: resolve the incoming host through Consul prepared-query
        # DNS, not by hardcoding service names in Caddy.
        dynamic srv _{host}._tcp.query.consul {
            resolvers 127.0.0.1:8600
            refresh 10s
        }

        lb_policy random
        fail_duration 30s

        transport http {
            dial_timeout 3s
            response_header_timeout 10s
            keepalive 30s
            resolvers 127.0.0.1:8600
        }
    }

    log {
        output stdout
        format console
    }
}