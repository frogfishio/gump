[Unit]
Description=Caddy on-demand TLS allowlist backed by Consul prepared queries
After=network-online.target consul.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/caddy-consul-ask.py --listen-host 127.0.0.1 --listen-port 9123 --consul-http http://127.0.0.1:8500
Restart=on-failure
RestartSec=2
User=root
Group=root

[Install]
WantedBy=multi-user.target